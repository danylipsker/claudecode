_preview_*.html

# Local editor / assistant settings
.claude/settings.local.json

# Separate repository checked out inside this one (own remote and history)
NOVELTECH/

# Generated toolpath output from Linear Half Toner
*.nc

# Bundled CircuitJS1 desktop build (third-party, ~370MB; the .zip alone exceeds
# GitHub's 100MB file limit). Used as a local same-origin mirror for verifying
# circuits — re-download rather than version it.
CIRCUITS/circuitjs1-win/
CIRCUITS/circuitjs1-win.zip

# DeepMind boxoban level dataset (third-party, ~171MB; Apache-licensed).
# Re-download from https://github.com/deepmind/boxoban-levels rather than
# version it — the game opens its .txt files at runtime via the Open button.
sokoban/boxoban-levels-master/

# Python bytecode
__pycache__/
*.pyc

