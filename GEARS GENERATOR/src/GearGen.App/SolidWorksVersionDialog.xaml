<Window x:Class="GearGen.App.SolidWorksVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export to SolidWorks" Height="220" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F9FAFB">
    <StackPanel Margin="24">
        <TextBlock Text="Save as SolidWorks version" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock Text="A native .sldprt can only be written by that version's own SolidWorks -- there's no &quot;save as older version&quot; for native parts. Pick the version installed on this machine you want to drive; if it isn't installed, the currently running one is used instead and you'll be told."
                   TextWrapping="Wrap" FontSize="11" Foreground="#6B7280" Margin="0,8,0,16"/>
        <ComboBox x:Name="VersionCombo" FontSize="14" Padding="8,6" SelectedIndex="6"/>
        <TextBlock x:Name="AvailabilityText" FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Padding="14,8" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="OkButton" Content="Export" Padding="18,8" Background="#2563EB" Foreground="White" BorderThickness="0" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
