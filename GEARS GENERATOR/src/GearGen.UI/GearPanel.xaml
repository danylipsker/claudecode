<UserControl x:Class="GearGen.UI.GearPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GearGen.UI"
             xmlns:hx="http://helix-toolkit.org/wpf"
             Background="#F9FAFB">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:ErrorColorConverter x:Key="ErrorColorConverter"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="ToggleBtn" TargetType="RadioButton">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="White" Padding="0,7">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" FontSize="12" Foreground="#374151"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#374151"/>
        </Style>

        <Style x:Key="GearCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#E5E7EB" BorderThickness="2" CornerRadius="8" Padding="8,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GearCardComingSoon" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,10"/>
        </Style>

        <!-- The view-preset buttons float over the 3D ground, which is now light:
             dark text on a near-opaque white chip (they used to be white text on
             a translucent chip over a near-black ground). -->
        <Style x:Key="ViewBtn" TargetType="Button">
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#9CA3AF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: parameter form ================= -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,16">
                <StackPanel>
                    <TextBlock Text="Gear Parameters" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="External involute spur, helical, herringbone, bevel, worm, rack &amp; internal gears" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>

                    <TextBlock Text="GEAR FAMILY" Style="{StaticResource SectionHeader}"/>
                    <!-- Three columns: the family set is growing past six, and two
                         columns would push the parameter form below the fold. -->
                    <UniformGrid Columns="3">
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsCylindricalSpur, Mode=OneWay}" Checked="OnCylindricalChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_spur.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Spur" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsCylindricalHelical, Mode=OneWay}" Checked="OnHelicalCardChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_helical.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Helical" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsHerringbone, Mode=OneWay}" Checked="OnHerringboneChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_herringbone.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Herringbone" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsCrossedHelical, Mode=OneWay}" Checked="OnScrewChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_screw.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Screw gears" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsPlanetary, Mode=OneWay}" Checked="OnPlanetaryChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_planetary.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Planetary" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsCycloidal, Mode=OneWay}" Checked="OnCycloidalChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_cycloidal.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Cycloidal" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsCycloidalDrive, Mode=OneWay}" Checked="OnCycloidalDriveChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_cycdrive.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Cycloidal drive" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsBevel, Mode=OneWay}" Checked="OnBevelChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_bevel.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Bevel" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsSpiralBevelSpiral, Mode=OneWay}" Checked="OnSpiralBevelChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_spiral_bevel.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Spiral bevel" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsSpiralBevelZerol, Mode=OneWay}" Checked="OnZerolBevelChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_zerol_bevel.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Zerol bevel" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsHypoid, Mode=OneWay}" Checked="OnHypoidChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_hypoid.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Hypoid" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsFaceGear, Mode=OneWay}" Checked="OnFaceGearChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_face_gear.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Face gear" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsSprocket, Mode=OneWay}" Checked="OnSprocketChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_sprocket.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Sprocket" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsChainLink, Mode=OneWay}" Checked="OnChainLinkChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_chain_link.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Chain link" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsTimingWheel, Mode=OneWay}" Checked="OnTimingWheelChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_timing_wheel.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Timing wheel" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsTimingBelt, Mode=OneWay}" Checked="OnTimingBeltChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_timing_belt.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Timing belt" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsGloboidWorm, Mode=OneWay}" Checked="OnGloboidWormChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_globoid_worm.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Globoid worm" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsWorm, Mode=OneWay}" Checked="OnWormChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_worm.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Worm" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsRackStraight, Mode=OneWay}" Checked="OnRackChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_rack.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Rack" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsRackHelical, Mode=OneWay}" Checked="OnHelicalRackChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_helical_rack.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Helical rack" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsInternal, Mode=OneWay}" Checked="OnInternalChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_internal.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Internal" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <!-- One button, labelled for whichever card is selected: each kind of
                         gear has its own canonical values (GearParameters.CreateDefaults). -->
                    <Button Content="{Binding ResetLabel}" Command="{Binding ResetToDefaultsCommand}"
                            Padding="10,5" Margin="0,2,6,0" HorizontalAlignment="Stretch" FontSize="12"
                            ToolTip="Put every parameter of the selected gear kind back to its default value. The unit system is kept."/>

                    <TextBlock Text="UNIT SYSTEM" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="unit" Content="Metric" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsMetric, Mode=OneWay}" Checked="OnMetricChecked"/>
                        <RadioButton Grid.Column="2" GroupName="unit" Content="Inch" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsInch, Mode=OneWay}" Checked="OnInchChecked"/>
                    </Grid>

                    <TextBlock Text="BASIC" Style="{StaticResource SectionHeader}"/>
                    <local:NumericSpinner Visibility="{Binding HasTeethField, Converter={StaticResource B2V}}"
                                           Label="{Binding TeethLabel}" Value="{Binding Teeth}" Minimum="4" Maximum="500" Step="1" DecimalPlaces="0"/>
                    <StackPanel Visibility="{Binding IsWorm, Converter={StaticResource B2V}}">
                        <local:NumericSpinner Label="Thread starts (z1)" Value="{Binding WormStarts}" Minimum="1" Maximum="10" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Pitch diameter" Value="{Binding PitchDiameterDisplay}" Minimum="1" Maximum="500" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>
                    <local:NumericSpinner Visibility="{Binding HasModuleField, Converter={StaticResource B2V}}"
                                           Label="{Binding ModuleOrDpLabel}" Value="{Binding ModuleOrDp}" Minimum="0.05" Maximum="200" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>

                    <StackPanel Visibility="{Binding IsNotCycloidal, Converter={StaticResource B2V}}">
                    <TextBlock Text="Pressure angle" FontSize="12" Foreground="#374151" Margin="0,0,0,3"/>
                    <local:NumericSpinner Value="{Binding PressureAngleDeg}" Minimum="5" Maximum="45" Step="0.5" DecimalPlaces="1" Suffix="°"/>
                    <StackPanel Orientation="Horizontal" Margin="0,-4,0,0">
                        <Button Content="14.5°" Padding="8,3" Margin="0,0,6,0" Command="{Binding SetPressureAnglePresetCommand}" CommandParameter="14.5"/>
                        <Button Content="20°" Padding="8,3" Margin="0,0,6,0" Command="{Binding SetPressureAnglePresetCommand}" CommandParameter="20"/>
                        <Button Content="25°" Padding="8,3" Command="{Binding SetPressureAnglePresetCommand}" CommandParameter="25"/>
                    </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowFaceWidthField, Converter={StaticResource B2V}}">
                    <TextBlock Text="SIZE" Style="{StaticResource SectionHeader}"/>
                    <local:NumericSpinner Visibility="{Binding HasFaceWidthSpinner, Converter={StaticResource B2V}}"
                                           Label="{Binding FaceWidthLabel}" Value="{Binding FaceWidthDisplay}" Minimum="0.5" Maximum="1000" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    <local:NumericSpinner Visibility="{Binding ShowBoreField, Converter={StaticResource B2V}}"
                                           Label="{Binding BoreOrHoleLabel}" Value="{Binding BoreDiameterDisplay}" Minimum="0" Maximum="1000" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowHelixSection, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding HelixSectionHeader}" Style="{StaticResource SectionHeader}"/>
                    <local:NumericSpinner Label="Helix angle" Value="{Binding HelixAngleDeg}" Minimum="0" Maximum="45" Step="0.5" DecimalPlaces="1" Suffix="°"/>
                    <Grid Visibility="{Binding IsHelical, Converter={StaticResource B2V}}" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="hand" Content="Right-hand" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsRightHand, Mode=OneWay}" Checked="OnRightHandChecked"/>
                        <RadioButton Grid.Column="2" GroupName="hand" Content="Left-hand" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsLeftHand, Mode=OneWay}" Checked="OnLeftHandChecked"/>
                    </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsFaceGear, Converter={StaticResource B2V}}">
                        <TextBlock Text="FACE GEAR" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Teeth cut into the face of a disc, driven by a spur pinion on a perpendicular axis. The teeth are generated exactly as a shaper pinion would cut them, so they change shape along the radius: thinner toward the outer end (pointed if the ring is too wide), undercut toward the inner end. A shaper with a few more teeth than the pinion localizes the contact. The preview shows the pinion in mesh; STEP export is the face gear alone (the pinion is an ordinary spur gear)."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Pinion teeth" Value="{Binding MateTeeth}" Minimum="4" Maximum="200" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Shaper teeth (0 = same as pinion)" Value="{Binding CutterTeeth}" Minimum="0" Maximum="200" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Ring inner radius (0 = auto)" Value="{Binding FaceInnerRadiusDisplay}" Minimum="0" Maximum="2000" Step="1" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Ring outer radius (0 = auto)" Value="{Binding FaceOuterRadiusDisplay}" Minimum="0" Maximum="2000" Step="1" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Rim below the root" Value="{Binding RimThicknessDisplay}" Minimum="0.5" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSprocket, Converter={StaticResource B2V}}">
                        <TextBlock Text="SPROCKET" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="A wheel for roller chain (ANSI B29.1 / ISO 606): the teeth seat a chain roller of the chosen chain's own diameter, one per pitch position, and taper between them to drive it. Pick a standard chain number to set pitch and roller diameter together, or set them directly for a non-standard chain. Outside diameter 0 = automatic."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="Chain number (ANSI B29.1)" FontSize="12" Foreground="#374151" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding ChainNumbers}" SelectedItem="{Binding ChainNumber}" Margin="0,0,0,8" Padding="6,4"/>
                        <local:NumericSpinner Label="Chain pitch" Value="{Binding ChainPitchDisplay}" Minimum="0.1" Maximum="200" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Roller diameter" Value="{Binding RollerDiameterDisplay}" Minimum="0.1" Maximum="100" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Outside diameter (0 = auto)" Value="{Binding OutsideDiameterDisplay}" Minimum="0" Maximum="2000" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsChainLink, Converter={StaticResource B2V}}">
                        <TextBlock Text="CHAIN LINK" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="One pitch length of roller chain: an outer link (two plates, two pins) pinned into an inner link (two plates, two bushings, two rollers) -- the same repeating unit a Sprocket of this chain is built to drive. Pick the chain number to match a sprocket built from the same chain; pin diameter, plate thickness and the rest follow standard-typical proportions of the pitch and roller diameter."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="Chain number (ANSI B29.1)" FontSize="12" Foreground="#374151" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding ChainNumbers}" SelectedItem="{Binding ChainNumber}" Margin="0,0,0,8" Padding="6,4"/>
                        <local:NumericSpinner Label="Chain pitch" Value="{Binding ChainPitchDisplay}" Minimum="0.1" Maximum="200" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Roller diameter" Value="{Binding RollerDiameterDisplay}" Minimum="0.1" Maximum="100" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsTimingWheel, Converter={StaticResource B2V}}">
                        <TextBlock Text="TIMING WHEEL" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="A toothed pulley for a timing belt: teeth = groove count, and the belt's own pitch sets the pulley's pitch circle (a true circle -- a belt is one continuous flexible band, not rigid links like a chain, so there is no polygon effect). Pick a standard belt (MXL/XL/L/H and ISO T-series are flat-sided trapezoidal; GT2 and HTD are rounded curvilinear) to set the pitch and tooth profile together, or edit the pitch directly. Pair it with a Timing belt of the same standard."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="Belt standard" FontSize="12" Foreground="#374151" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding BeltTypes}" SelectedItem="{Binding BeltType}" Margin="0,0,0,8" Padding="6,4"/>
                        <local:NumericSpinner Label="Belt pitch" Value="{Binding BeltPitchDisplay}" Minimum="0.5" Maximum="100" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsTimingBelt, Converter={StaticResource B2V}}">
                        <TextBlock Text="TIMING BELT" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="A modelled segment of timing belt: a flexible band with teeth at the given pitch, wide at the backing and narrower at the tip -- flat-sided for the trapezoidal standards (MXL/XL/L/H, ISO T-series), rounded for the curvilinear ones (GT2, HTD) -- the same shape a matching Timing wheel's grooves are cut to receive. 'Teeth shown' is just how much of the belt to model, not a meshing dimension."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="Belt standard" FontSize="12" Foreground="#374151" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding BeltTypes}" SelectedItem="{Binding BeltType}" Margin="0,0,0,8" Padding="6,4"/>
                        <local:NumericSpinner Label="Belt pitch" Value="{Binding BeltPitchDisplay}" Minimum="0.5" Maximum="100" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Teeth shown" Value="{Binding CutterTeeth}" Minimum="3" Maximum="60" Step="1" DecimalPlaces="0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsGloboidWorm, Converter={StaticResource B2V}}">
                        <TextBlock Text="GLOBOID (DOUBLE-ENVELOPING) WORM" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="A worm turned to wrap its wheel -- an hourglass whose every thread turn is in mesh, not just the throat -- with a wheel throated around the worm in turn (Hindley / cone-drive). The thread flanks are straight lines in the central plane, tangent to a base circle about the wheel centre; the wheel is generated from the built worm, so the pair meshes by construction. The preview and the STEP are the pair in mesh."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Thread starts (z1)" Value="{Binding WormStarts}" Minimum="1" Maximum="6" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Wheel teeth (z2)" Value="{Binding MateTeeth}" Minimum="12" Maximum="200" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Throat pitch diameter (worm)" Value="{Binding PitchDiameterDisplay}" Minimum="1" Maximum="500" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Wrapped wheel pitches" Value="{Binding EnvelopeTeeth}" Minimum="1" Maximum="12" Step="0.5" DecimalPlaces="1"/>
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="globoidhand" Content="Right-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsRightHand, Mode=OneWay}" Checked="OnRightHandChecked"/>
                            <RadioButton Grid.Column="2" GroupName="globoidhand" Content="Left-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsLeftHand, Mode=OneWay}" Checked="OnLeftHandChecked"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsHypoid, Converter={StaticResource B2V}}">
                        <TextBlock Text="HYPOID" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="A spiral bevel gear driven by a pinion whose axis passes the gear's at the hypoid offset instead of meeting it -- the automotive final drive. The offset makes the pinion larger and more steeply spiralled than the same-ratio bevel pinion (quieter, stronger, and the drive shaft sits lower). The gear is an ordinary spiral bevel gear; the pinion's spiral angle, pitch angle and size follow from the offset, and its teeth are generated from the gear itself, so the pair meshes by construction. The preview and the STEP are the pair in mesh."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Pinion teeth" Value="{Binding MateTeeth}" Minimum="4" Maximum="200" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Hypoid offset (0 = spiral bevel)" Value="{Binding OffsetDisplay}" Minimum="0" Maximum="500" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Gear spiral angle" Value="{Binding SpiralAngleDeg}" Minimum="0" Maximum="60" Step="1" DecimalPlaces="1" Suffix="°"/>
                        <local:NumericSpinner Label="Cutter radius (0 = auto)" Value="{Binding CutterRadiusDisplay}" Minimum="0" Maximum="2000" Step="1" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="hypoidhand" Content="Right-hand gear" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsRightHand, Mode=OneWay}" Checked="OnRightHandChecked"/>
                            <RadioButton Grid.Column="2" GroupName="hypoidhand" Content="Left-hand gear" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsLeftHand, Mode=OneWay}" Checked="OnLeftHandChecked"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSpiralBevel, Converter={StaticResource B2V}}">
                        <TextBlock Text="SPIRAL BEVEL" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Teeth curve across the face along a circular arc (the Gleason trace): the spiral angle is the tooth's inclination at mid-face (35° is usual; 0° makes a zerol gear, curved teeth with no mean inclination), and the cutter radius sets how tightly the arc bends (0 = automatic, the mean cone distance). The pressure angle above is the normal one. A mating pinion has the opposite hand."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Spiral angle (0 = zerol)" Value="{Binding SpiralAngleDeg}" Minimum="0" Maximum="60" Step="1" DecimalPlaces="1" Suffix="°"/>
                        <local:NumericSpinner Label="Cutter radius (0 = auto)" Value="{Binding CutterRadiusDisplay}" Minimum="0" Maximum="2000" Step="1" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="spiralhand" Content="Right-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsRightHand, Mode=OneWay}" Checked="OnRightHandChecked"/>
                            <RadioButton Grid.Column="2" GroupName="spiralhand" Content="Left-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsLeftHand, Mode=OneWay}" Checked="OnLeftHandChecked"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsAnyBevel, Converter={StaticResource B2V}}">
                        <TextBlock Text="BEVEL CONE" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Mating gear's tooth count, and the angle between the two shafts (90° for the usual right-angle drive), set the cone angle this gear needs to mesh correctly."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Mate gear teeth" Value="{Binding MateTeeth}" Minimum="4" Maximum="500" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Shaft angle" Value="{Binding ShaftAngleDeg}" Minimum="10" Maximum="170" Step="1" DecimalPlaces="1" Suffix="°"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsWorm, Converter={StaticResource B2V}}">
                        <TextBlock Text="WORM" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="wormhand" Content="Right-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsRightHand, Mode=OneWay}" Checked="OnRightHandChecked"/>
                            <RadioButton Grid.Column="2" GroupName="wormhand" Content="Left-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsLeftHand, Mode=OneWay}" Checked="OnLeftHandChecked"/>
                        </Grid>
                        <TextBlock Text="Mate wheel tooth count -- for center-distance info only. There's no separate 'wheel' mode: build the actual wheel with the Helical card using the module/helix/hand shown below."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Wheel teeth (z2, 0 = skip)" Value="{Binding MateTeeth}" Minimum="0" Maximum="500" Step="1" DecimalPlaces="0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRack, Converter={StaticResource B2V}}">
                        <TextBlock Text="RACK" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="A gear track -- 'Number of teeth' above sets how many fit along its length. The mounting-hole spinner above (SIZE section) drills one hole per tooth pitch through the backing bar. A helix angle (HELIX section) inclines the teeth across the face for meshing with a helical pinion of the OPPOSITE hand: module and pressure angle are then the normal values, pitch and thickness along the bar are transverse."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Backing height" Value="{Binding BackingHeightDisplay}" Minimum="0.5" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsCycloidalDrive, Converter={StaticResource B2V}}">
                        <TextBlock Text="CYCLOIDAL DRIVE (SPEED REDUCER)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="An eccentric input turns a lobed disc rolling inside a ring of (lobes + 1) rollers; the disc turns back one lobe per input revolution, so the reduction is lobes : 1 with zero backlash. Keep the eccentricity below (pin circle radius) / (lobes + 1) or the profile cusps. Output pins fixed to the output shaft run in holes (pin + 2 x eccentricity) in the disc. STEP export writes the disc, rollers and output pins in mesh as one multi-body part."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Pin (roller) circle diameter" Value="{Binding PinCircleDisplay}" Minimum="1" Maximum="2000" Step="1" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Roller diameter" Value="{Binding RollerDiameterDisplay}" Minimum="0.1" Maximum="500" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Eccentricity" Value="{Binding EccentricityDisplay}" Minimum="0.01" Maximum="100" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Output pins (0 = no output holes)" Value="{Binding OutputPinCount}" Minimum="0" Maximum="24" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Output pin diameter" Value="{Binding OutputPinDiameterDisplay}" Minimum="0.1" Maximum="500" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Output pin circle diameter" Value="{Binding OutputCircleDisplay}" Minimum="0.1" Maximum="2000" Step="1" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsCycloidal, Converter={StaticResource B2V}}">
                        <TextBlock Text="CYCLOIDAL" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Clock and instrument gearing: the flank above the pitch circle is an epicycloid and below it a hypocycloid, both traced by one rolling circle -- there is no pressure angle. 0 = automatic: the rolling circle diameter equals this gear's pitch radius, which makes the dedendum flanks straight radial lines (the classic clock pinion). Two gears mesh only if they share the same rolling circle and run at the exact centre distance."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Rolling circle diameter (0 = auto)" Value="{Binding RollingCircleDisplay}" Minimum="0" Maximum="500" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPlanetary, Converter={StaticResource B2V}}">
                        <TextBlock Text="PLANETARY SET" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="'Number of teeth' above is the sun's. The ring's tooth count follows (sun + 2 x planet), and equally spaced planets can only all mesh when (sun + ring) divides by their count -- you'll be warned otherwise. Bore applies to the sun and the planets; the ring gets the rim below. STEP export writes every member in mesh as one multi-body part."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Planet teeth" Value="{Binding MateTeeth}" Minimum="4" Maximum="200" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Number of planets" Value="{Binding PlanetCount}" Minimum="1" Maximum="12" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Ring rim thickness" Value="{Binding RimThicknessDisplay}" Minimum="0.5" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsCrossedHelical, Converter={StaticResource B2V}}">
                        <TextBlock Text="SCREW GEAR PAIR (CROSSED HELICAL)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Two helical gears on shafts that cross without intersecting. 'Number of teeth', helix angle and hand above describe gear 1; gear 2's helix and hand follow from the shaft angle (same hand when the shaft angle exceeds gear 1's helix, e.g. 45° + 45° = 90°). Both share the normal module and pressure angle; the ratio is z2/z1. Contact is a single point, so screw gears suit light loads. STEP export writes both gears in mesh as a two-body part."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Gear 2 teeth (z2)" Value="{Binding MateTeeth}" Minimum="4" Maximum="500" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Shaft angle" Value="{Binding ShaftAngleDeg}" Minimum="10" Maximum="170" Step="1" DecimalPlaces="1" Suffix="°"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsHerringbone, Converter={StaticResource B2V}}">
                        <TextBlock Text="DOUBLE HELICAL (HERRINGBONE)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Two opposite-hand helical halves on one blank, mirror-symmetric about the mid-face so the axial thrust cancels. The helix angle and hand above describe the half at one face; the other half is the opposite hand. Centre gap 0 = a true herringbone (sharp V apex); larger = the hob-runout groove a machined double-helical gear carries, cut at the root diameter."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Centre gap (0 = none)" Value="{Binding GapWidthDisplay}" Minimum="0" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsInternal, Converter={StaticResource B2V}}">
                        <TextBlock Text="INTERNAL (RING) GEAR" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Teeth point inward -- 'Number of teeth' above is the ring's own tooth count. Meshes with an external pinion running inside it (same rotation direction, unlike two external gears)."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Rim thickness" Value="{Binding RimThicknessDisplay}" Minimum="0.5" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Construction cutter teeth (0 = auto)" Value="{Binding CutterTeeth}" Minimum="0" Maximum="200" Step="1" DecimalPlaces="0"/>
                        <TextBlock Text="Mating pinion tooth count -- for center-distance info only, no separate 'pinion' mode: build the actual pinion with the Spur/Helical card."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,8,0,8"/>
                        <local:NumericSpinner Label="Pinion teeth (0 = skip)" Value="{Binding MateTeeth}" Minimum="0" Maximum="500" Step="1" DecimalPlaces="0"/>
                    </StackPanel>

                    <Expander Header="ADVANCED" Margin="0,14,0,0" Foreground="#6B7280" FontSize="11" FontWeight="Bold">
                        <StackPanel Margin="0,10,0,0">
                            <local:NumericSpinner Label="Profile shift coefficient (x)" Value="{Binding ProfileShift}" Minimum="-1" Maximum="1" Step="0.05" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Addendum coefficient (ha*)" Value="{Binding AddendumCoeff}" Minimum="0.1" Maximum="2" Step="0.05" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Dedendum coefficient (hf*)" Value="{Binding DedendumCoeff}" Minimum="0.1" Maximum="3" Step="0.05" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Root fillet coefficient (ρf*)" Value="{Binding RootFilletCoeff}" Minimum="0" Maximum="0.8" Step="0.02" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Backlash" Value="{Binding BacklashDisplay}" Minimum="0" Maximum="10" Step="0.01" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= RIGHT: preview + derived values + export ================= -->
        <Grid Grid.Column="1" Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 3D preview: the actual tessellated solid (bore, twist, cone
                 taper all visible exactly as they'll export), not a flat
                 cross-section. Orbit (drag), pan (right/middle-drag) and zoom
                 (wheel) are already built into HelixViewport3D; the buttons
                 below add orthographic view presets and zoom-to-fit. -->
            <!-- A light, slightly graded ground (the CAD-viewer convention) in
                 place of the earlier near-black one: a mid-blue gear shades
                 visibly against it, and the dark feature edges drawn over the
                 model read as outlines instead of vanishing into the ground. -->
            <Border Grid.Row="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FAFBFC" Offset="0"/>
                        <GradientStop Color="#C9D2DE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ClipToBounds="True">
                    <hx:HelixViewport3D x:Name="Viewport3D" Background="Transparent"
                                         ShowCoordinateSystem="True" ShowViewCube="True"
                                         ZoomExtentsWhenLoaded="False" IsHeadLightEnabled="True">
                        <hx:HelixViewport3D.Camera>
                            <PerspectiveCamera Position="70,-70,55" LookDirection="-1,1,-0.8" UpDirection="0,0,1" FieldOfView="35"/>
                        </hx:HelixViewport3D.Camera>
                        <hx:SunLight/>
                        <ModelVisual3D Content="{Binding Model3D}"/>
                        <!-- "Shaded with edges": the model's feature edges (tooth
                             outlines on both faces, tip/root corners along the face
                             width, a herringbone's apex, cone rims; see
                             FeatureEdges.cs) as thin dark lines over the shading.
                             Screen-space thickness, so they stay one line wide at
                             any zoom. (No double hyphens in this comment: XML
                             forbids them and it has broken this build before.) -->
                        <hx:LinesVisual3D Points="{Binding EdgePoints}" Color="#1F2937" Thickness="1.2"/>
                    </hx:HelixViewport3D>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                        <Button Content="Front" Style="{StaticResource ViewBtn}" Click="OnViewFront"/>
                        <Button Content="Top" Style="{StaticResource ViewBtn}" Click="OnViewTop"/>
                        <Button Content="Right" Style="{StaticResource ViewBtn}" Click="OnViewRight"/>
                        <Button Content="Iso" Style="{StaticResource ViewBtn}" Click="OnViewIso"/>
                        <Button Content="⤢ Fit" Style="{StaticResource ViewBtn}" Click="OnZoomExtents"/>
                    </StackPanel>

                    <Border Background="#CC111827" CornerRadius="4" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                            Visibility="{Binding IsMeshBusy, Converter={StaticResource B2V}}">
                        <TextBlock Text="Rebuilding 3D model…" Foreground="White" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- derived values -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="14,10">
              <StackPanel>
                <UniformGrid Columns="3" Rows="2">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="PITCH DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PitchDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="BASE DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BaseDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="OUTSIDE (TIP) DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AddendumDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ROOT DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DedendumDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TOOTH THICKNESS" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ToothThicknessText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="EQUIVALENT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ModuleOrDpEquivalentText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsHelical, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="TRANSVERSE MODULE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TransverseModuleText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="LEAD" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LeadText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TWIST" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TwistText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsCycloidalDrive, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="REDUCTION" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DriveRatioText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="PROFILE LIMITS" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DriveLimitsText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="OUTPUT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DriveOutputText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsCycloidal, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="ROLLING CIRCLE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RollingCircleText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsPlanetary, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="RING GEAR" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RingText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CENTRE DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CenterDistanceText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="RATIOS" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RatiosText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsCrossedHelical, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="GEAR 2" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Gear2Text}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CENTRE DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CenterDistanceText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="RATIO" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RatioText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsFaceGear, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="PINION AND SHAPER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FaceGearText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TOOTHED RING" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FaceRingText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="RING LIMITS" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FaceLimitsText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsSprocket, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="CHAIN" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SprocketChainText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ROOT / OUTSIDE DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SprocketDiametersText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsChainLink, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="CHAIN" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SprocketChainText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="LINK DIMENSIONS" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SprocketDiametersText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsTimingWheel, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="TIMING BELT FIT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TimingWheelText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsTimingBelt, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="BELT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TimingBeltText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsGloboidWorm, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="WORM AND WHEEL" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding GloboidText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="WRAP" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding GloboidWrapText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsHypoid, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="PINION" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HypoidPinionText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="OFFSET" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HypoidOffsetText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsSpiralBevel, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="SPIRAL ANGLE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SpiralText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CUTTER RADIUS" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CutterText}" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsAnyBevel, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="PITCH ANGLE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PitchAngleText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="OUTER CONE DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ConeDistanceText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="VIRTUAL TEETH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ZVirtualText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Visibility="{Binding IsWorm, Converter={StaticResource B2V}}" Margin="0,10,0,0">
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Text="LEAD" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LeadText}" FontSize="13" Foreground="#111827"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LEAD ANGLE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LeadAngleText}" FontSize="13" Foreground="#111827"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CENTER DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CenterDistanceText}" FontSize="13" Foreground="#111827"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="MATCHING WHEEL (via Helical card)" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding WheelHintText}" FontSize="12" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsRack, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="CIRCULAR PITCH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CircularPitchText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ADDENDUM HEIGHT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AddendumHeightText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DEDENDUM HEIGHT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DedendumHeightText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="TOTAL LENGTH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalLengthText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsInternal, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="OUTER DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding OuterDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CONSTRUCTION CUTTER TEETH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CutterTeethText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CENTER DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CenterDistanceText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- warnings -->
            <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="12,8"
                    Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="#92400E"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- export buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Button Content="Export DXF (.dxf)" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnExportDxfClick"/>
                <Button Content="Export STEP (.step)" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnExportStepClick"/>
                <Button Content="{Binding SolidWorksActionLabel}" Style="{StaticResource PrimaryBtn}" Command="{Binding ExportSolidWorksCommand}"/>
            </StackPanel>

            <!-- status -->
            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="11"
                       Foreground="{Binding IsError, Converter={StaticResource ErrorColorConverter}, FallbackValue=#6B7280}"/>
        </Grid>
    </Grid>
</UserControl>
