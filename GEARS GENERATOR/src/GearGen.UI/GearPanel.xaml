<UserControl x:Class="GearGen.UI.GearPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GearGen.UI"
             xmlns:hx="http://helix-toolkit.org/wpf"
             Background="#F9FAFB">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:ErrorColorConverter x:Key="ErrorColorConverter"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="ToggleBtn" TargetType="RadioButton">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="White" Padding="0,7">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" FontSize="12" Foreground="#374151"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#374151"/>
        </Style>

        <Style x:Key="GearCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#E5E7EB" BorderThickness="2" CornerRadius="8" Padding="8,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GearCardComingSoon" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,10"/>
        </Style>

        <Style x:Key="ViewBtn" TargetType="Button">
            <Setter Property="Background" Value="#33E5E7EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#6B7280" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: parameter form ================= -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,16">
                <StackPanel>
                    <TextBlock Text="Gear Parameters" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="External involute spur, helical, herringbone, bevel, worm, rack &amp; internal gears" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>

                    <TextBlock Text="GEAR FAMILY" Style="{StaticResource SectionHeader}"/>
                    <!-- Three columns: the family set is growing past six, and two
                         columns would push the parameter form below the fold. -->
                    <UniformGrid Columns="3">
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsCylindricalSpur, Mode=OneWay}" Checked="OnCylindricalChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_spur.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Spur" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsCylindricalHelical, Mode=OneWay}" Checked="OnHelicalCardChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_helical.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Helical" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsHerringbone, Mode=OneWay}" Checked="OnHerringboneChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_herringbone.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Herringbone" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsBevel, Mode=OneWay}" Checked="OnBevelChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_bevel.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Bevel" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsWorm, Mode=OneWay}" Checked="OnWormChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_worm.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Worm" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsRackStraight, Mode=OneWay}" Checked="OnRackChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_rack.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Rack" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsRackHelical, Mode=OneWay}" Checked="OnHelicalRackChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_helical_rack.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Helical rack" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="family" Style="{StaticResource GearCard}"
                                     IsChecked="{Binding IsInternal, Mode=OneWay}" Checked="OnInternalChecked">
                            <StackPanel>
                                <Image Source="Assets/thumb_internal.png" Height="76" Stretch="Uniform"/>
                                <TextBlock Text="Internal" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="UNIT SYSTEM" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="unit" Content="Metric" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsMetric, Mode=OneWay}" Checked="OnMetricChecked"/>
                        <RadioButton Grid.Column="2" GroupName="unit" Content="Inch" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsInch, Mode=OneWay}" Checked="OnInchChecked"/>
                    </Grid>

                    <TextBlock Text="BASIC" Style="{StaticResource SectionHeader}"/>
                    <local:NumericSpinner Visibility="{Binding IsNotWorm, Converter={StaticResource B2V}}"
                                           Label="Number of teeth (z)" Value="{Binding Teeth}" Minimum="4" Maximum="500" Step="1" DecimalPlaces="0"/>
                    <StackPanel Visibility="{Binding IsWorm, Converter={StaticResource B2V}}">
                        <local:NumericSpinner Label="Thread starts (z1)" Value="{Binding WormStarts}" Minimum="1" Maximum="10" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Pitch diameter" Value="{Binding PitchDiameterDisplay}" Minimum="1" Maximum="500" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>
                    <local:NumericSpinner Label="{Binding ModuleOrDpLabel}" Value="{Binding ModuleOrDp}" Minimum="0.05" Maximum="200" Step="0.1" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>

                    <TextBlock Text="Pressure angle" FontSize="12" Foreground="#374151" Margin="0,0,0,3"/>
                    <local:NumericSpinner Value="{Binding PressureAngleDeg}" Minimum="5" Maximum="45" Step="0.5" DecimalPlaces="1" Suffix="°"/>
                    <StackPanel Orientation="Horizontal" Margin="0,-4,0,0">
                        <Button Content="14.5°" Padding="8,3" Margin="0,0,6,0" Command="{Binding SetPressureAnglePresetCommand}" CommandParameter="14.5"/>
                        <Button Content="20°" Padding="8,3" Margin="0,0,6,0" Command="{Binding SetPressureAnglePresetCommand}" CommandParameter="20"/>
                        <Button Content="25°" Padding="8,3" Command="{Binding SetPressureAnglePresetCommand}" CommandParameter="25"/>
                    </StackPanel>

                    <TextBlock Text="SIZE" Style="{StaticResource SectionHeader}"/>
                    <local:NumericSpinner Label="{Binding FaceWidthLabel}" Value="{Binding FaceWidthDisplay}" Minimum="0.5" Maximum="1000" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    <local:NumericSpinner Visibility="{Binding IsNotInternal, Converter={StaticResource B2V}}"
                                           Label="{Binding BoreOrHoleLabel}" Value="{Binding BoreDiameterDisplay}" Minimum="0" Maximum="1000" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>

                    <StackPanel Visibility="{Binding ShowHelixSection, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding HelixSectionHeader}" Style="{StaticResource SectionHeader}"/>
                    <local:NumericSpinner Label="Helix angle" Value="{Binding HelixAngleDeg}" Minimum="0" Maximum="45" Step="0.5" DecimalPlaces="1" Suffix="°"/>
                    <Grid Visibility="{Binding IsHelical, Converter={StaticResource B2V}}" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="hand" Content="Right-hand" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsRightHand, Mode=OneWay}" Checked="OnRightHandChecked"/>
                        <RadioButton Grid.Column="2" GroupName="hand" Content="Left-hand" Style="{StaticResource ToggleBtn}"
                                     IsChecked="{Binding IsLeftHand, Mode=OneWay}" Checked="OnLeftHandChecked"/>
                    </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsBevel, Converter={StaticResource B2V}}">
                        <TextBlock Text="BEVEL CONE" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Mating gear's tooth count, and the angle between the two shafts (90° for the usual right-angle drive), set the cone angle this gear needs to mesh correctly."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Mate gear teeth" Value="{Binding MateTeeth}" Minimum="4" Maximum="500" Step="1" DecimalPlaces="0"/>
                        <local:NumericSpinner Label="Shaft angle" Value="{Binding ShaftAngleDeg}" Minimum="10" Maximum="170" Step="1" DecimalPlaces="1" Suffix="°"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsWorm, Converter={StaticResource B2V}}">
                        <TextBlock Text="WORM" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="wormhand" Content="Right-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsRightHand, Mode=OneWay}" Checked="OnRightHandChecked"/>
                            <RadioButton Grid.Column="2" GroupName="wormhand" Content="Left-hand" Style="{StaticResource ToggleBtn}"
                                         IsChecked="{Binding IsLeftHand, Mode=OneWay}" Checked="OnLeftHandChecked"/>
                        </Grid>
                        <TextBlock Text="Mate wheel tooth count -- for center-distance info only. There's no separate 'wheel' mode: build the actual wheel with the Helical card using the module/helix/hand shown below."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Wheel teeth (z2, 0 = skip)" Value="{Binding MateTeeth}" Minimum="0" Maximum="500" Step="1" DecimalPlaces="0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRack, Converter={StaticResource B2V}}">
                        <TextBlock Text="RACK" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="A gear track -- 'Number of teeth' above sets how many fit along its length. The mounting-hole spinner above (SIZE section) drills one hole per tooth pitch through the backing bar. A helix angle (HELIX section) inclines the teeth across the face for meshing with a helical pinion of the OPPOSITE hand: module and pressure angle are then the normal values, pitch and thickness along the bar are transverse."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Backing height" Value="{Binding BackingHeightDisplay}" Minimum="0.5" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsHerringbone, Converter={StaticResource B2V}}">
                        <TextBlock Text="DOUBLE HELICAL (HERRINGBONE)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Two opposite-hand helical halves on one blank, mirror-symmetric about the mid-face so the axial thrust cancels. The helix angle and hand above describe the half at one face; the other half is the opposite hand. Centre gap 0 = a true herringbone (sharp V apex); larger = the hob-runout groove a machined double-helical gear carries, cut at the root diameter."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Centre gap (0 = none)" Value="{Binding GapWidthDisplay}" Minimum="0" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsInternal, Converter={StaticResource B2V}}">
                        <TextBlock Text="INTERNAL (RING) GEAR" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Teeth point inward -- 'Number of teeth' above is the ring's own tooth count. Meshes with an external pinion running inside it (same rotation direction, unlike two external gears)."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <local:NumericSpinner Label="Rim thickness" Value="{Binding RimThicknessDisplay}" Minimum="0.5" Maximum="200" Step="0.5" DecimalPlaces="2" Suffix="{Binding LengthSuffix}"/>
                        <local:NumericSpinner Label="Construction cutter teeth (0 = auto)" Value="{Binding CutterTeeth}" Minimum="0" Maximum="200" Step="1" DecimalPlaces="0"/>
                        <TextBlock Text="Mating pinion tooth count -- for center-distance info only, no separate 'pinion' mode: build the actual pinion with the Spur/Helical card."
                                   TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,8,0,8"/>
                        <local:NumericSpinner Label="Pinion teeth (0 = skip)" Value="{Binding MateTeeth}" Minimum="0" Maximum="500" Step="1" DecimalPlaces="0"/>
                    </StackPanel>

                    <Expander Header="ADVANCED" Margin="0,14,0,0" Foreground="#6B7280" FontSize="11" FontWeight="Bold">
                        <StackPanel Margin="0,10,0,0">
                            <local:NumericSpinner Label="Profile shift coefficient (x)" Value="{Binding ProfileShift}" Minimum="-1" Maximum="1" Step="0.05" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Addendum coefficient (ha*)" Value="{Binding AddendumCoeff}" Minimum="0.1" Maximum="2" Step="0.05" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Dedendum coefficient (hf*)" Value="{Binding DedendumCoeff}" Minimum="0.1" Maximum="3" Step="0.05" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Root fillet coefficient (ρf*)" Value="{Binding RootFilletCoeff}" Minimum="0" Maximum="0.8" Step="0.02" DecimalPlaces="3"/>
                            <local:NumericSpinner Label="Backlash" Value="{Binding BacklashDisplay}" Minimum="0" Maximum="10" Step="0.01" DecimalPlaces="3" Suffix="{Binding LengthSuffix}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= RIGHT: preview + derived values + export ================= -->
        <Grid Grid.Column="1" Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 3D preview: the actual tessellated solid (bore, twist, cone
                 taper all visible exactly as they'll export), not a flat
                 cross-section. Orbit (drag), pan (right/middle-drag) and zoom
                 (wheel) are already built into HelixViewport3D; the buttons
                 below add orthographic view presets and zoom-to-fit. -->
            <Border Grid.Row="0" Background="#1F2937" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <hx:HelixViewport3D x:Name="Viewport3D" Background="Transparent"
                                         ShowCoordinateSystem="True" ShowViewCube="True"
                                         ZoomExtentsWhenLoaded="False" IsHeadLightEnabled="True">
                        <hx:HelixViewport3D.Camera>
                            <PerspectiveCamera Position="70,-70,55" LookDirection="-1,1,-0.8" UpDirection="0,0,1" FieldOfView="35"/>
                        </hx:HelixViewport3D.Camera>
                        <hx:SunLight/>
                        <ModelVisual3D Content="{Binding Model3D}"/>
                    </hx:HelixViewport3D>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                        <Button Content="Front" Style="{StaticResource ViewBtn}" Click="OnViewFront"/>
                        <Button Content="Top" Style="{StaticResource ViewBtn}" Click="OnViewTop"/>
                        <Button Content="Right" Style="{StaticResource ViewBtn}" Click="OnViewRight"/>
                        <Button Content="Iso" Style="{StaticResource ViewBtn}" Click="OnViewIso"/>
                        <Button Content="⤢ Fit" Style="{StaticResource ViewBtn}" Click="OnZoomExtents"/>
                    </StackPanel>

                    <Border Background="#CC111827" CornerRadius="4" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                            Visibility="{Binding IsMeshBusy, Converter={StaticResource B2V}}">
                        <TextBlock Text="Rebuilding 3D model…" Foreground="White" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- derived values -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="14,10">
              <StackPanel>
                <UniformGrid Columns="3" Rows="2">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="PITCH DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PitchDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="BASE DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BaseDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="OUTSIDE (TIP) DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AddendumDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ROOT DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DedendumDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TOOTH THICKNESS" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ToothThicknessText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="EQUIVALENT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ModuleOrDpEquivalentText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsHelical, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="TRANSVERSE MODULE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TransverseModuleText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="LEAD" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LeadText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TWIST" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TwistText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsBevel, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="PITCH ANGLE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PitchAngleText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="OUTER CONE DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ConeDistanceText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="VIRTUAL TEETH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ZVirtualText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Visibility="{Binding IsWorm, Converter={StaticResource B2V}}" Margin="0,10,0,0">
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Text="LEAD" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LeadText}" FontSize="13" Foreground="#111827"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LEAD ANGLE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LeadAngleText}" FontSize="13" Foreground="#111827"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CENTER DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CenterDistanceText}" FontSize="13" Foreground="#111827"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="MATCHING WHEEL (via Helical card)" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding WheelHintText}" FontSize="12" Foreground="#111827" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsRack, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="CIRCULAR PITCH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CircularPitchText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ADDENDUM HEIGHT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AddendumHeightText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DEDENDUM HEIGHT" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DedendumHeightText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="TOTAL LENGTH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalLengthText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsInternal, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="OUTER DIAMETER" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding OuterDiameterText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CONSTRUCTION CUTTER TEETH" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CutterTeethText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CENTER DISTANCE" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CenterDistanceText}" FontSize="13" Foreground="#111827"/>
                    </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- warnings -->
            <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="12,8"
                    Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="#92400E"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- export buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Button Content="Export DXF (.dxf)" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnExportDxfClick"/>
                <Button Content="Export STEP (.step)" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnExportStepClick"/>
                <Button Content="{Binding SolidWorksActionLabel}" Style="{StaticResource PrimaryBtn}" Command="{Binding ExportSolidWorksCommand}"/>
            </StackPanel>

            <!-- status -->
            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="11"
                       Foreground="{Binding IsError, Converter={StaticResource ErrorColorConverter}, FallbackValue=#6B7280}"/>
        </Grid>
    </Grid>
</UserControl>
